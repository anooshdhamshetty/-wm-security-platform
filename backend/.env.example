# GitHub API token (raises rate limit; needed for private repos)
GITHUB_TOKEN=

# Database (SQLite by default for the basic model; swap for Postgres in production)
DATABASE_URL=sqlite:///./security_platform.db
# DATABASE_URL=postgresql://user:password@localhost:5432/security_platform

# LLM provider used ONLY for the evidence-analysis reasoning layer.
# "groq" (default) or "anthropic"
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# Safety: comma-separated hostnames the httpx test runner is allowed to hit.
# Requests to any other host are refused, regardless of what is requested.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1
TARGET_BASE_URL=http://localhost:8080

# Safety limits
MAX_REQUESTS_PER_ASSESSMENT=200
REQUEST_RATE_LIMIT_PER_SEC=2
REQUEST_TIMEOUT_SECONDS=10

# CORS
CORS_ORIGINS=http://localhost:5173
